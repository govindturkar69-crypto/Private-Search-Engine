        "y": 12
      },
      "id": 6,
      "title": "Search Cache Hit Rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(rate(search_engine_cache_hits_total[1m]) or vector(0)) / ((rate(search_engine_cache_hits_total[1m]) or vector(0)) + (rate(search_engine_cache_misses_total[1m]) or vector(0)) > 0) * 100",
          "legendFormat": "Cache Hit Rate %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
